<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="M3PrimaryColor">#6750A4</Color>
    <Color x:Key="M3OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="M3SurfaceColor">#FFFBFE</Color>
    <Color x:Key="M3SurfaceVariantColor">#E7E0EC</Color>
    <Color x:Key="M3OnSurfaceVariantColor">#49454F</Color>
    <Color x:Key="M3OutlineColor">#79747E</Color>
    <Color x:Key="M3HoverColor">#1F000000</Color>
    <Color x:Key="M3PressedColor">#33000000</Color>
    <Color x:Key="M3DisabledTextColor">#61000000</Color>
    <Color x:Key="M3DisabledOutlineColor">#1F000000</Color>

    <SolidColorBrush x:Key="M3PrimaryBrush" Color="{StaticResource M3PrimaryColor}"/>
    <SolidColorBrush x:Key="M3OnSurfaceVariantBrush" Color="{StaticResource M3OnSurfaceVariantColor}"/>
    <SolidColorBrush x:Key="M3OutlineBrush" Color="{StaticResource M3OutlineColor}"/>
    <SolidColorBrush x:Key="M3SurfaceBrush" Color="{StaticResource M3SurfaceColor}"/>
    <SolidColorBrush x:Key="M3SurfaceVariantBrush" Color="{StaticResource M3SurfaceVariantColor}"/>
    <SolidColorBrush x:Key="M3HoverBrush" Color="{StaticResource M3HoverColor}"/>
    <SolidColorBrush x:Key="M3PressedBrush" Color="{StaticResource M3PressedColor}"/>
    <SolidColorBrush x:Key="M3DisabledTextBrush" Color="{StaticResource M3DisabledTextColor}"/>
    <SolidColorBrush x:Key="M3DisabledOutlineBrush" Color="{StaticResource M3DisabledOutlineColor}"/>


    <Style x:Key="ButtonM3Secondary" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource M3OutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="{StaticResource M3OnSurfaceVariantBrush}"/>
        <Setter Property="Padding" Value="12 6"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"/>

                        <ContentPresenter
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="{TemplateBinding Padding}"/>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                    Value="{StaticResource M3HoverBrush}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="{StaticResource M3PressedBrush}"/>
                            <Setter TargetName="border"
                                    Property="BorderBrush"
                                    Value="{StaticResource M3PrimaryBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{StaticResource M3DisabledTextBrush}"/>
                            <Setter TargetName="border"
                                    Property="BorderBrush"
                                    Value="{StaticResource M3DisabledOutlineBrush}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
