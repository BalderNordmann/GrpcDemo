<UserControl x:Class="GrpcClient.Themes.UserControls.ShoppingCartItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GrpcClient.Themes.UserControls"
             xmlns:themes="clr-namespace:GrpcClient.Themes"
             mc:Ignorable="d" 
             d:DesignHeight="68" d:DesignWidth="600">   
    
    <Border Padding="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
        <Grid Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding ItemName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="16"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Height="48">
                <themes:IconButtonM3 Style="{StaticResource IconButtonM3}" Click="Minus_Click" IconImageData="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z" Width="48" Height="48"/>
                <themes:IconButtonM3 Style="{StaticResource IconButtonM3}" Click="Minus_Click" IconImageData="M200-440v-80h560v80H200Z" Width="48" Height="48"/>

                <TextBlock Text="{Binding Quantity, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="16"
                           Width="48"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           />

                <themes:IconButtonM3 Style="{StaticResource IconButtonM3}" Click="Plus_Click" IconImageData="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z" Width="48" Height="48"/>

                <TextBlock Text="{Binding ItemPrice, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            FontSize="16"
                            Width="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextAlignment="Right"
                            />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
