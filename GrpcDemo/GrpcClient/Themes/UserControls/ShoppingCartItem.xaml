<UserControl x:Class="GrpcClient.Themes.UserControls.ShoppingCartItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GrpcClient.Themes.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Padding="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding ItemName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="16"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                <Button Width="30" Height="30" Content="-" Click="Minus_Click"/>

                <TextBlock Text="{Binding Quantity, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="16"
                           Width="30"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <Button Width="30" Height="30" Content="+" Click="Plus_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
