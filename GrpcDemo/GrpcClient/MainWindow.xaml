                        <controls:ShoppingCartItem ItemName="Apple" Quantity="2" ItemPrice="33.55" Width="600" Height="78" Margin="0,0,0,10"/>
                    </WrapPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        
        <Border Background="#f2f2f2" CornerRadius="20" Margin="5,73,680,0"/>
        
