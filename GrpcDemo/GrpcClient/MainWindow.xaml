                        <ToggleButton Style="{StaticResource ChipM3}" Content="Memoir" IsChecked="True" Height="40" Padding="10,10" Margin="10,5,0,5"/>
                        <ToggleButton Style="{StaticResource ChipM3}" Content="Literary Fiction" IsChecked="True" Height="40" Padding="10,10" Margin="10,5,0,5"/>
                        <ToggleButton Style="{StaticResource ChipM3}" Content="Thriller" IsChecked="True" Height="40" Padding="10,10" Margin="10,5,0,5"/>
                        <ToggleButton Style="{StaticResource ChipM3}" Content="Adventure Fiction" IsChecked="True" Height="40" Padding="10,10" Margin="10,5,0,5"/>
                        <ToggleButton Style="{StaticResource ChipM3}" Content="ChildrensLiterature" IsChecked="True" Height="40" Padding="10,10" Margin="10,5,0,5"/>
